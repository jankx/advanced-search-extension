{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "jankx-advanced-search/search",
    "title": "Advanced Search",
    "category": "jankx",
    "icon": "search",
    "description": "Search form với auto-suggest (Federated Search), post type selector và taxonomy filter box — thay thế smart-search block.",
    "keywords": [
        "search",
        "tim kiem",
        "form",
        "tìm kiếm",
        "suggestion",
        "federated",
        "filter"
    ],
    "textdomain": "jankx",
    "attributes": {
        "label": {
            "type": "string",
            "role": "content"
        },
        "showLabel": {
            "type": "boolean",
            "default": true
        },
        "placeholder": {
            "type": "string",
            "default": "",
            "role": "content"
        },
        "width": {
            "type": "number"
        },
        "widthUnit": {
            "type": "string",
            "default": "px"
        },
        "buttonText": {
            "type": "string",
            "role": "content"
        },
        "buttonPosition": {
            "type": "string",
            "default": "button-outside"
        },
        "buttonUseIcon": {
            "type": "boolean",
            "default": false
        },
        "query": {
            "type": "object",
            "default": {}
        },
        "isSearchFieldHidden": {
            "type": "boolean",
            "default": false
        },
        "enableSuggestions": {
            "type": "boolean",
            "default": true
        },
        "suggestionMinChars": {
            "type": "number",
            "default": 2
        },
        "suggestionDebounce": {
            "type": "number",
            "default": 300
        },
        "suggestionPerGroup": {
            "type": "number",
            "default": 5
        },
        "showPostTypeFilter": {
            "type": "boolean",
            "default": false
        },
        "showTaxonomyFilter": {
            "type": "boolean",
            "default": false
        },
        "defaultPostType": {
            "type": "string",
            "default": ""
        },
        "filterTaxonomy": {
            "type": "string",
            "default": ""
        },
        "queryId": {
            "type": "string",
            "default": ""
        },
        "searchResultsUrl": {
            "type": "string",
            "default": ""
        },
        "iconName": {
            "type": "string",
            "default": ""
        },
        "iconSet": {
            "type": "string",
            "default": "material"
        },
        "iconCategory": {
            "type": "string",
            "default": "navigation"
        },
        "iconSize": {
            "type": "string",
            "default": "24px"
        },
        "iconColor": {
            "type": "string",
            "default": ""
        },
        "iconBackgroundColor": {
            "type": "string",
            "default": ""
        },
        "iconBackgroundValue": {
            "type": "string",
            "default": ""
        },
        "iconPadding": {
            "type": "string",
            "default": "8px"
        },
        "iconBorderRadius": {
            "type": "string",
            "default": "4px"
        }
    },
    "supports": {
        "anchor": true,
        "align": [
            "left",
            "center",
            "right",
            "wide",
            "full"
        ],
        "color": {
            "gradients": true,
            "__experimentalSkipSerialization": true,
            "__experimentalDefaultControls": {
                "background": true,
                "text": true
            }
        },
        "typography": {
            "__experimentalSkipSerialization": true,
            "__experimentalSelector": ".wp-block-search__label, .wp-block-search__input, .wp-block-search__button",
            "fontSize": true,
            "lineHeight": true,
            "__experimentalFontFamily": true,
            "__experimentalFontWeight": true,
            "__experimentalFontStyle": true,
            "__experimentalTextTransform": true,
            "__experimentalTextDecoration": true,
            "__experimentalLetterSpacing": true,
            "__experimentalDefaultControls": {
                "fontSize": true
            }
        },
        "__experimentalBorder": {
            "color": true,
            "radius": true,
            "width": true,
            "__experimentalSkipSerialization": true,
            "__experimentalDefaultControls": {
                "color": true,
                "radius": true,
                "width": true
            }
        },
        "spacing": {
            "margin": true,
            "padding": true
        },
        "html": false
    },
    "editorScript": "file:../../dist/blocks/search/index.js",
    "editorStyle": "file:../../dist/blocks/search.css",
    "style": "file:../../dist/blocks/style-search.css"
}